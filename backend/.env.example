# Database
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@HOSTNAME:5432/postgres

# Redis
REDIS_URL=redis://default:PASSWORD@HOSTNAME:6379/0

# App Settings
APP_NAME=Floxcy MVP API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Security
ADMIN_API_KEY=change-this-in-production
CORS_ORIGINS=["http://localhost:3000","https://floxcy.com"]

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=Floxcy MVP
